{
  "manifest_version": 3,
  "name": "ApplyMate",
  "version": "1.0.0",
  "description": "Personal job application autofill assistant for Safari",

  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],

  "action": {
    "default_title": "ApplyMate",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
